{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["context", "task", "constraints", "verification", "output_format", "handoff"],
  "properties": {
    "context": {"type": "object", "required": ["goal", "audience", "stage", "source_artifacts", "context_sources", "repository", "existing_tests", "design_references", "documentation", "previous_versions", "prior_review_findings"], "properties": {"goal": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}, "stage": {"type": "string", "minLength": 1}, "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "context_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "repository": {"type": "string", "minLength": 1}, "existing_tests": {"type": "string", "minLength": 1}, "design_references": {"type": "string", "minLength": 1}, "documentation": {"type": "string", "minLength": 1}, "previous_versions": {"type": "string", "minLength": 1}, "prior_review_findings": {"type": "string", "minLength": 1}}},
    "task": {"type": "object", "required": ["objective", "user_outcome", "in_scope", "first_vertical_slice"], "properties": {"objective": {"type": "string", "minLength": 1}, "user_outcome": {"type": "string", "minLength": 1}, "in_scope": {"type": "array", "items": {"type": "string"}}, "first_vertical_slice": {"type": "string", "minLength": 1}, "approved_handoff": {"type": "string"}}},
    "constraints": {"type": "object", "required": ["house_rules", "scope_exclusions", "acceptance_criteria"], "properties": {"house_rules": {"type": "array"}, "scope_exclusions": {"type": "array"}, "acceptance_criteria": {"type": "array", "minItems": 1}, "technical": {"type": "array"}, "security_privacy": {"type": "array"}, "conventions": {"type": "array"}, "integration_boundaries": {"type": "array"}, "approval_boundaries": {"type": "array"}, "timebox_budget": {"type": "string"}}},
    "verification": {"type": "object", "required": ["do_not_finish_until", "evidence", "unresolved"], "properties": {"do_not_finish_until": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check", "evidence", "status", "owner"], "properties": {"check": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "unresolved", "blocked", "not_applicable"]}, "owner": {"enum": ["implementation", "reviewer", "user"]}}}}, "evidence": {"type": "array"}, "unresolved": {"type": "array"}}},
    "output_format": {"type": "object", "required": ["files", "summary", "completion_evidence"], "properties": {"files": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "shape": {"type": "string"}, "issue_format": {"type": "string"}, "summary": {"type": "string", "minLength": 1}, "completion_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "handoff": {"type": "object", "required": ["first_action", "dependencies", "next_checkpoint"], "properties": {"first_action": {"type": "string", "minLength": 1}, "dependencies": {"type": "array"}, "next_checkpoint": {"type": "string", "minLength": 1}, "recovery": {"type": "string"}}}
  }
}
