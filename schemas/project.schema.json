{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "capabilities", "assumptions", "decisions"],
  "properties": {
    "project": {"type": "object", "required": ["id", "stage", "mode", "created_at", "updated_at"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "stage": {"type": "string"}, "mode": {"enum": ["prototype", "hackathon", "indie", "saas", "startup", "production", "custom"]}, "goal": {"type": "string"}, "protected_outcome": {"type": "string"}, "path": {"type": "string"}}},
    "workflow_profile": {"$ref": "workflow-profile.schema.json"},
    "house_rules": {"type": "object", "properties": {"constraints": {"type": "array"}, "non_negotiables": {"type": "array"}, "scope_exclusions": {"type": "array"}, "evidence_policy": {"type": "string"}, "approval_boundaries": {"type": "array"}}},
    "session": {"type": "object", "properties": {"status": {"enum": ["intake", "in_progress", "reviewing", "checkpointed", "blocked", "paused"]}, "current_phase": {"type": "string"}, "current_gate": {"type": "string"}, "next_action": {"type": "string"}, "questions": {"type": "array"}, "unanswered_questions": {"type": "array"}, "iteration_count": {"type": "integer", "minimum": 0}, "approval_status": {"enum": ["pending", "approved", "self_review_only", "blocked"]}, "updated_at": {"type": "string"}}},
    "phases": {"type": "object", "additionalProperties": {"type": "object", "properties": {"status": {"enum": ["pending", "in_progress", "reviewing", "checkpointed", "approved", "blocked", "skipped"]}, "done_bar": {"type": "array"}, "result": {}}}},
    "reviews": {"type": "array", "items": {"type": "object", "required": ["phase", "reviewer", "independent", "passed"], "properties": {"phase": {"type": "string"}, "reviewer": {"type": "string"}, "independent": {"type": "boolean"}, "passed": {"type": "boolean"}, "findings": {"type": "array"}}}},
    "validation": {"type": "object", "properties": {"verdict": {"enum": ["holds", "needs_narrowing", "weak_evidence", "saturated"]}, "rounds": {"type": "integer", "minimum": 0}, "confidence": {"type": "string"}}},
    "specify": {"type": "object", "properties": {"behavior_spec": {"type": "string"}, "mirror": {"type": "string"}, "behaviors": {"type": "integer", "minimum": 0}, "open_ambiguities": {"type": "integer", "minimum": 0}, "validated": {"type": "boolean"}}},
    "final_planning": {"type": "object", "properties": {"status": {"enum": ["pending", "drafting", "reviewing", "approved", "blocked", "done"]}, "source_artifacts": {"type": "array"}, "implementation_brief": {"type": "string"}, "context_sources": {"type": "array"}, "constraints": {"type": "array"}, "verification": {"type": "object", "required": ["do_not_finish_until", "evidence", "unresolved"], "properties": {"do_not_finish_until": {"type": "array", "minItems": 1}, "evidence": {"type": "array"}, "unresolved": {"type": "array"}}}, "output_format": {"type": "object"}, "reviewer": {"type": "string"}, "review_iterations": {"type": "integer", "minimum": 0}, "approval_status": {"enum": ["pending", "approved", "self_review_only", "blocked"]}}},
    "capabilities": {"type": "object"},
    "define": {"type": "object", "description": "The six slots a product definition is made of. Each string holds the slot's answer only; its confidence number and its citation or A-### live in the Product Opportunity Brief, which is where the done bar reads them. The checkpoint checks these strings for emptiness and placeholders wherever the compiled profile sets define.gate to required.", "properties": {"slots": {"type": "object", "properties": {"customer": {"type": "string"}, "pain": {"type": "string"}, "outcome": {"type": "string"}, "mechanism": {"type": "string"}, "pricing": {"type": "string"}, "proof": {"type": "string"}}}, "research": {"type": "object"}}},
    "business": {"type": "object"},
    "constraints": {"type": "object"},
    "assumptions": {"type": "array"},
    "decisions": {"type": "array"},
    "design": {"type": "object", "properties": {"evidence": {"type": "array", "description": "What proves the critical interaction is understood. Required only when the compiled profile sets design.gate to evidence_required. A published design canvas counts.", "items": {"type": "string"}}, "prompt": {"type": "string", "description": "Path to the Design Prompt artifact. Always written, whether or not a canvas provider exists."}, "canvas_provider": {"type": "string", "description": "Which provider actually rendered the canvas, or empty when none did. Never record one that did not run."}, "canvas_url": {"type": "string"}}},
    "mvp": {"type": "object"},
    "production": {"type": "object"},
    "github": {"type": "object"}
  }
}
