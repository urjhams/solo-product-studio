{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "capabilities", "assumptions", "decisions"],
  "properties": {
    "project": {"type": "object", "required": ["id", "stage", "mode", "created_at", "updated_at"], "properties": {"goal": {"type": "string"}, "protected_outcome": {"type": "string"}, "path": {"type": "string"}}},
    "house_rules": {"type": "object", "properties": {"constraints": {"type": "array"}, "non_negotiables": {"type": "array"}, "scope_exclusions": {"type": "array"}, "evidence_policy": {"type": "string"}, "approval_boundaries": {"type": "array"}}},
    "session": {"type": "object", "properties": {"status": {"enum": ["intake", "in_progress", "reviewing", "checkpointed", "blocked", "paused"]}, "current_phase": {"type": "string"}, "current_gate": {"type": "string"}, "next_action": {"type": "string"}, "questions": {"type": "array"}, "unanswered_questions": {"type": "array"}, "iteration_count": {"type": "integer", "minimum": 0}, "approval_status": {"enum": ["pending", "approved", "self_review_only", "blocked"]}, "updated_at": {"type": "string"}}},
    "phases": {"type": "object", "additionalProperties": {"type": "object", "properties": {"status": {"enum": ["pending", "in_progress", "reviewing", "checkpointed", "approved", "blocked", "skipped"]}, "done_bar": {"type": "array"}, "result": {}}}},
    "reviews": {"type": "array", "items": {"type": "object", "required": ["phase", "reviewer", "independent", "passed"], "properties": {"phase": {"type": "string"}, "reviewer": {"type": "string"}, "independent": {"type": "boolean"}, "passed": {"type": "boolean"}, "findings": {"type": "array"}}}},
    "capabilities": {"type": "object"},
    "product": {"type": "object"},
    "business": {"type": "object"},
    "constraints": {"type": "object"},
    "research": {"type": "object"},
    "assumptions": {"type": "array"},
    "decisions": {"type": "array"},
    "design": {"type": "object"},
    "mvp": {"type": "object"},
    "production": {"type": "object"},
    "github": {"type": "object"}
  }
}
